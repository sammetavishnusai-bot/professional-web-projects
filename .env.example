# =============================================================================
# ResuSphere AI Server Configuration
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file containing secrets to version control.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Future External AI Provider Integration (Server-Side Only)
# Note: Keep these keys secure and NEVER expose them in client-side code.
AI_PROVIDER=custom # Options: 'custom', 'openai', 'gemini', 'anthropic'
AI_API_KEY=your_api_key_here
AI_API_ENDPOINT=https://api.example.com/v1
AI_MODEL_NAME=model-name-here
AI_TIMEOUT_MS=15000
