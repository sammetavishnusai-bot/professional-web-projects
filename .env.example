# =============================================================================
# ResuSphere AI Server Configuration
# Copy this template file to .env and configure your local settings.
# NEVER commit the actual .env file containing secrets to version control.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# OpenAI API Integration (Server-Side Only - NEVER expose to browser)
# Provide your secret key from platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
